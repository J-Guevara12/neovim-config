-- Java LSP configuration using nvim-jdtls for Hybris projects
local jdtls = require('jdtls')

-- ALWAYS use Hybris platform directory as root for multi-project support
local hybris_platform = '/mnt/newdisk/fsp_21/hybris/bin/platform'
local root_dir = hybris_platform
local workspace_dir = vim.fn.expand('~/.cache/jdtls/workspace/hybris-platform')

-- Paths
local jdtls_path = vim.fn.expand('~/.local/share/nvim/mason/packages/jdtls')
local launcher_jar = vim.fn.glob(jdtls_path .. '/plugins/org.eclipse.equinox.launcher_*.jar')
local config_dir = jdtls_path .. '/config_linux'

-- Configuration
local config = {
    cmd = {
        'java',
        '-Declipse.application=org.eclipse.jdt.ls.core.id1',
        '-Dosgi.bundles.defaultStartLevel=4',
        '-Declipse.product=org.eclipse.jdt.ls.core.product',
        '-Dlog.protocol=true',
        '-Dlog.level=ALL',
        '-Xmx2g',  -- Aumentado a 2GB para proyectos grandes como Hybris
        '-Xms512m',
        '--add-modules=ALL-SYSTEM',
        '--add-opens', 'java.base/java.util=ALL-UNNAMED',
        '--add-opens', 'java.base/java.lang=ALL-UNNAMED',
        '-jar', launcher_jar,
        '-configuration', config_dir,
        '-data', workspace_dir,
    },
    root_dir = root_dir,
    settings = {
        java = {
            eclipse = {
                downloadSources = true,
            },
            configuration = {
                updateBuildConfiguration = "automatic",  -- Cambiar a automatic para Gradle
                runtimes = {}  -- Detectar automáticamente
            },
            format = {
                enabled = true,
                settings = {
                    url = nil,  -- Usar formato por defecto
                    profile = "GoogleStyle"
                }
            },
            autobuild = {
                enabled = true
            },
            maxConcurrentBuilds = 1,  -- Evitar sobrecarga en builds grandes
            completion = {
                enabled = true,
                favoriteStaticMembers = {
                    "org.junit.Assert.*",
                    "org.junit.Assume.*",
                    "org.junit.jupiter.api.Assertions.*",
                    "org.junit.jupiter.api.Assumptions.*",
                    "org.junit.jupiter.api.DynamicContainer.*",
                    "org.junit.jupiter.api.DynamicTest.*",
                    "org.mockito.Mockito.*",
                    "org.mockito.ArgumentMatchers.*",
                    "org.mockito.Answers.*"
                },
                filteredTypes = {
                    "com.sun.*",
                    "java.awt.*",
                    "jdk.*",
                    "sun.*"
                },
                importOrder = {
                    "java",
                    "javax",
                    "org",
                    "com",
                    "de.hybris"
                }
            },
            maven = {
                downloadSources = true,
            },
            implementationsCodeLens = {
                enabled = true,
            },
            referencesCodeLens = {
                enabled = true,
            },
            references = {
                includeDecompiledSources = true,
            },
            signatureHelp = {
                enabled = true,
                description = {
                    enabled = true
                }
            },
            contentProvider = {
                preferred = "fernflower"
            },
            sources = {
                organizeImports = {
                    starThreshold = 9999,
                    staticStarThreshold = 9999
                }
            },
            project = {
                referencedLibraries = {
                    -- Platform core libraries
                    '/mnt/newdisk/fsp_21/hybris/bin/platform/ext/core/lib/*.jar',
                    '/mnt/newdisk/fsp_21/hybris/bin/platform/tomcat/lib/*.jar',
                    '/mnt/newdisk/fsp_21/hybris/bin/platform/lib/**/*.jar',
                    '/mnt/newdisk/fsp_21/hybris/bin/platform/ext/**/lib/*.jar',
                    -- Custom modules libraries
                    '/mnt/newdisk/fsp_21/hybris/bin/custom/core-customize/hybris/bin/custom/fsp/**/lib/*.jar',
                    '/mnt/newdisk/fsp_21/hybris/bin/custom/core-customize/hybris/bin/custom/**/lib/*.jar',
                    -- Additional modules
                    '/mnt/newdisk/fsp_21/hybris/bin/modules/**/lib/*.jar',
                },
                sourcePaths = {}  -- Dejar que Gradle detecte los source paths
            },
            import = {
                gradle = {
                    enabled = true,
                    wrapper = {
                        enabled = false  -- No usar wrapper, jdtls usará su Gradle embebido
                    },
                    offline = {
                        enabled = false  -- Permitir descarga de dependencias
                    },
                    home = nil,  -- Dejar que jdtls use su Gradle embebido
                    java = {
                        home = nil  -- Usar el mismo JDK que jdtls
                    },
                    version = nil,  -- Autodetectar
                    arguments = nil,
                    jvmArguments = nil,
                    user = {
                        home = nil  -- Usar ~/.gradle por defecto
                    }
                },
                maven = {
                    enabled = false
                },
                exclusions = {
                    "**/node_modules/**",
                    "**/.git/**",
                    "**/target/**",
                    "**/bin/**",
                    "**/.settings/**",
                }
            }
        }
    },
    init_options = {
        bundles = {},
        extendedClientCapabilities = {
            classFileContentsSupport = true,
            resolveAdditionalTextEditsSupport = true,
            progressReportProvider = true
        }
    },
    flags = {
        allow_incremental_sync = true,
    },
    on_attach = function(client, bufnr)
        local opts = {buffer = bufnr, remap = false}
        vim.keymap.set("n", "gd", function() vim.lsp.buf.definition() end, opts)
        vim.keymap.set("n", "K", function() vim.lsp.buf.hover() end, opts)
        vim.keymap.set("n", "<leader>vws", function() vim.lsp.buf.workspace_symbol() end, opts)
        vim.keymap.set("n", "<leader>vd", function() vim.diagnostic.open_float() end, opts)
        vim.keymap.set("n", "{d", function() vim.diagnostic.goto_next() end, opts)
        vim.keymap.set("n", "}d", function() vim.diagnostic.goto_prev() end, opts)
        vim.keymap.set("n", "<leader>vca", function() vim.lsp.buf.code_action() end, opts)
        vim.keymap.set("n", "<leader>vrr", function() vim.lsp.buf.references() end, opts)
        vim.keymap.set("n", "<leader>vrn", function() vim.lsp.buf.rename() end, opts)
        vim.keymap.set("i", "<C-h>", function() vim.lsp.buf.signature_help() end, opts)
    end,
}

-- Start jdtls
jdtls.start_or_attach(config)
